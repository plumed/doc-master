phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17
TTMETAD ...
  ARG=phi,psi
  SIGMA=0.25,0.25
  HEIGHT=1.0
  BIASFACTOR=8
  TEMP=300
  PACE=500
  SKETCH_PACE=500000
  SKETCH_NBASIS=31
  SKETCH_INITRANK=60
  SKETCH_CUTOFF=1e-4
  INTERVAL_MIN=-pi,-pi
  INTERVAL_MAX=pi,pi
  FILE=HILLS
  LABEL=tt
... TTMETAD
PRINT ARG=tt.bias FILE=COLVAR STRIDE=100
