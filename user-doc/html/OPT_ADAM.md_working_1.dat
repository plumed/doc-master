phi:   TORSION ATOMS=5,7,9,15

bf1: BF_FOURIER ORDER=5 MINIMUM=-pi MAXIMUM=pi

VES_LINEAR_EXPANSION ...
 ARG=phi
 BASIS_FUNCTIONS=bf1
 LABEL=ves1
 TEMP=300.0
 GRID_BINS=100
... VES_LINEAR_EXPANSION

OPT_ADAM ...
  BIAS=ves1
  STRIDE=1000
  LABEL=o1
  STEPSIZE=0.001
  COEFFS_FILE=coefficients.data
  COEFFS_OUTPUT=10
  FES_OUTPUT=100
  BIAS_OUTPUT=100
... OPT_ADAM
